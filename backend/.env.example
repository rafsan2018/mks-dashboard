# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=elliance_mks
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# Email notification delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=Modbus Monitor <alerts@example.com>

# Threshold alert emails: how often the backend checks the newest readings (seconds, 0 = off)
ALERT_POLL_SECONDS=60
# Optional: lets a cron job run the same check with
#   curl -X POST -H "x-monitor-token: <token>" http://localhost:5000/api/v1/alert-monitor/run
# Leave empty to switch that endpoint off.
ALERT_MONITOR_TOKEN=

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# API
API_PREFIX=/api/v1
