# Production settings for the cPanel server.
# Copy this file to backend/.env.production (git-ignored) and fill in the real values.
# deploy/build-cpanel.mjs packs backend/.env.production into the backend zip as `.env`.

NODE_ENV=production
# cPanel (Passenger) chooses the real port itself; this value is ignored there.
PORT=5000

# Database. If MySQL is on the same cPanel account, use DB_HOST=localhost.
# cPanel database and user names usually start with your account name, e.g. myacct_elliance_mks.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# Email (threshold alerts and test email). cPanel mailboxes: host is usually mail.yourdomain.com.
SMTP_HOST=mail.elliancesystem.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@elliancesystem.com
SMTP_PASSWORD=your_mailbox_password
EMAIL_FROM=Modbus Monitor <alerts@elliancesystem.com>

# Threshold alert emails: how often the backend checks the newest readings (seconds, 0 = off).
# If cPanel stops the app when it is idle, set 0 and let a cron job call the endpoint instead:
#   curl -s -X POST -H "x-monitor-token: <token>" https://mks.elliancesystem.com/api/v1/alert-monitor/run
ALERT_POLL_SECONDS=60
ALERT_MONITOR_TOKEN=change_this_to_a_long_random_text

# The dashboard's address. MUST match the frontend domain exactly (https, no trailing slash),
# or the browser blocks every API call with a CORS error.
CORS_ORIGIN=https://mks.elliancesystem.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
LOG_DIR=logs

API_PREFIX=/api/v1
